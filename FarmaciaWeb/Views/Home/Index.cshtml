@{
    ViewData["Title"] = "Farmacia";
}

<div class="container text-center mt-5">

    <h1 class="display-4 text-primary">💊 Farmacia</h1>
    <p class="lead">Sistema de gestión farmacéutica</p>

    <hr />

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <h4>Bienvenido @User.Identity.Name 👋</h4>

        <div class="mt-4">

            <a href="/Categorias" class="btn btn-primary m-2">
                Categorías
            </a>

            <a href="/Estantes" class="btn btn-success m-2">
                Estantes
            </a>

        </div>
    }
    else
    {
        <div class="alert alert-info mt-4">
            Debes iniciar sesión
        </div>

        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary m-2">
            Login
        </a>

        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-primary m-2">
            Register
        </a>
    }

</div>