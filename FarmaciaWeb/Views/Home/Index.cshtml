@{
    ViewData["Title"] = "Panel de Control";
}

<div class="container mt-4">
    <div class="row mb-4 text-center">
        <h1 class="display-5 text-success fw-bold"><i class="bi bi-speedometer2"></i> Dashboard Administrativo</h1>
        <p class="text-muted">Estado actual de la Farmacia al @DateTime.Now.ToShortDateString()</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card bg-success text-white shadow h-100 border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase">Total Medicamentos</h6>
                            <h2 class="fw-bold">@ViewBag.TotalMedicamentos</h2>
                        </div>
                        <i class="bi bi-capsule fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-danger text-white shadow h-100 border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase">Vencidos (URGENTE)</h6>
                            <h2 class="fw-bold">@ViewBag.Vencidos</h2>
                        </div>
                        <i class="bi bi-calendar-x fs-1 opacity-50"></i>
                    </div>
                </div>
                <a asp-controller="Medicamentos" asp-action="Index" class="card-footer text-white small text-center text-decoration-none">Ver lista <i class="bi bi-arrow-right-short"></i></a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-warning text-dark shadow h-100 border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase fw-bold">Stock Crítico (< 5)</h6>
                            <h2 class="fw-bold">@ViewBag.BajoStock</h2>
                        </div>
                        <i class="bi bi-exclamation-triangle fs-1 opacity-50"></i>
                    </div>
                </div>
                <a asp-controller="Medicamentos" asp-action="Index" class="card-footer text-dark small text-center text-decoration-none">Revisar inventario <i class="bi bi-arrow-right-short"></i></a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-info text-white shadow h-100 border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase">Vencen en 30 días</h6>
                            <h2 class="fw-bold">@ViewBag.PorVencer30</h2>
                        </div>
                        <i class="bi bi-clock-history fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-secondary text-white shadow h-100 border-0">
                <div class="card-body text-center">
                    <h6>Categorías: <strong>@ViewBag.TotalCategorias</strong></h6>
                    <a asp-controller="Categorias" asp-action="Index" class="btn btn-sm btn-light mt-2">Gestionar</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-dark text-white shadow h-100 border-0">
                <div class="card-body text-center">
                    <h6>Estantes: <strong>@ViewBag.TotalEstantes</strong></h6>
                    <a asp-controller="Estantes" asp-action="Index" class="btn btn-sm btn-outline-light mt-2">Ver Ubicaciones</a>
                </div>
            </div>
        </div>
    </div>
</div>