@model IEnumerable<FarmaciaWeb.Models.Categoria>

<h2>Categorías</h2>

@if (TempData["mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["mensaje"]
    </div>
}

@if (User.IsInRole("Administrador") || User.IsInRole("Farmaceutico"))
{
    <a asp-action="Create" class="btn btn-primary">Nuevo</a>
}

<table class="table">
    <tr>
        <th>ID</th>
        <th>Nombre</th>
        <th>Descripción</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Nombre</td>
            <td>@item.Descripcion</td>
            <td>
                @if (User.IsInRole("Administrador") || User.IsInRole("Farmaceutico"))
                {
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Editar</a>
                }

                @if (User.IsInRole("Administrador"))
                {
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Eliminar</a>
                }

                @if (User.IsInRole("Cliente"))
                {
                    <button class="btn btn-success">Comprar</button>
                }
            </td>
        </tr>
    }
</table>